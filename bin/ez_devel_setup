#!/bin/bash

// xxx remove this
function install_pkgs()
{
    sudo apt update

    sudo apt install -y build-essential
    sudo apt install -y openjdk-17-jdk-headless
    sudo apt install -y git
    sudo apt install -y ssl-dev
    sudo apt install -y cscope universal-ctags
}

function install_android_sdk()
{
    # verify arg supplied
    cmdlinetoolszip=$1
    if [ "$cmdlinetoolszip" = "" ]; then
        echo "ERROR: path to cmdlinetools.zip required"
        # xxx usage
        exit 1
    fi

    # verify zip file exists, and is really a zip file
    if [ ! -f $cmdlinetoolszip ]; then
        echo "ERROR: $cmdlinetoolszip does not exist"
        exit 1
    fi
    if ! file --mime-type "$cmdlinetoolszip" | grep -q 'application/zip'; then
        echo "ERROR: $cmdlinetoolszip is not a zip archive."
        exit 1
    fi

    # to avoid a possible problem, kill gradle daemon and remove gradle daemon directory
    if true; then
        echo "Kill and cleanup gradle daemon"
        pkill -f gradle 
        sleep 3
        rm -rf ~/.gradle/daemon
        echo
    fi

    # if the ~/android dir exists then rename it to a save file
    if [ -d ~/android ]; then
        date_str=`date +%y%m%d_%H%M%S`
        android_save=~/android_save_$date_str
        echo "About to rename existing ~/android to $android_save"
        read -p "Continue (y/n)? " yn
        if [ "$yn" != "y" ]; then
            echo ABORT
            exit 1
        fi
        mv ~/android $android_save
        echo
    fi

    # if ~/android still exists then an error has occurred
    if [ -e ~/android ]; then
        echo "ERROR: something is wrong ~/android still exists"
        exit 1
    fi

    # unzip the cmdlinetools
    echo "Unzipping $cmdlinetoolszip"
    mkdir -p ~/android/sdk
    cd ~/android/sdk
    unzip $cmdlinetoolszip
    echo

    # move cmdline-tools to required dir struct
    echo "Move cmdline-tools to required dir struct"
    mv cmdline-tools latest
    mkdir cmdline-tools
    mv latest cmdline-tools
    echo

    # install sdk packages needed to build ezApp to run on Android
    echo "Install android/sdk packages"
    sdkmanager "platform-tools" "platforms;android-35" "build-tools;34.0.0" "ndk;27.0.12077973"
    echo

    # list installed sdk packages
    echo "List installed android/sdk packages"
    sdkmanager --list_installed
    echo
}

# ######## MAIN ########

if [ $# -eq 0 ]; then
    echo "Usage:"
    echo "- ez_devel_setup install_pkgs"
    echo "- ez_devel_setup install_android_sdk <path_to_cmdlinetools_zip>"
    echo
    echo "Notes:"
    echo "- commandlinetools-linux-nnnnnnnn_latest.zip is obtained from"
    echo "  https://developer.android.com/studio#command-line-tools-only"
    echo
    echo "- required env variables:"
    echo '    export ANDROID_HOME=$HOME/android/sdk'
    echo '    export ANDROID_NDK_ROOT=$ANDROID_HOME/ndk/27.0.12077973'
    echo '    export PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools'
    echo '    export PATH=$PATH:~/ezApp/bin'
    exit 0
fi

cmd=$1
arg=$2

case "$cmd" in
install_pkgs)
    install_pkgs
    ;;
install_android_sdk)
    install_android_sdk $arg
    ;;
*)
    echo "ERROR: invalid cmd: $cmd"
    ;;
esac

