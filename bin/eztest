#!/bin/bash

# default is to test app using picoc
CMD=$1
if [ "$CMD" = "" ]; then
    CMD=picoc
fi

# get CMD and validate
if [ "$CMD" != build -a "$CMD" != linux -a "$CMD" != picoc ]; then
    echo "ERROR: expected: build, linux, or picoc"
    echo "ERROR: default is picoc"
    exit 1
fi

# verify parent directory is 'apps' or 'svcs'
PARENT_DIR=$(basename $(dirname $PWD))
if [ "$PARENT_DIR" != apps -a "$PARENT_DIR" != svcs ]; then
    echo "ERROR: parent_dir must be apps or svcs"
    exit 1
fi

# set variables
APP_DIR=$(basename $(pwd))

# xxx -Wno-format-truncation ?
APP_NAME=$APP_DIR
CFLAGS="-Wall -Werror -Wno-unused-result -Wno-format-truncation -fcommon -g -I. "

# build and run is performed from the 'files' dir
cd ../..

# get list of src files, relative to the 'files' dir
SRCS=$(echo $PARENT_DIR/$APP_DIR/*.c)

# debug
#echo "PARENT_DIR  = $PARENT_DIR"
#echo "APP_DIR     = $APP_DIR"
#echo "APP_NAME    = $APP_NAME"
#echo "SRCS        = $SRCS"
#echo "CFLAGS      = $CFLAGS"

# perform command
if [ "$CMD" = build ]; then
    set -x
    gcc -DLINUX -o /tmp/$APP_NAME $CFLAGS $SRCS \
        -I ../linux/local/include \
        -L ../linux/local/lib -lezapp_lib -lmp3lame -llodepng -lcJSON -lSDL3 -lSDL3_ttf -lSDL3_mixer -lm
    { set +x; } 2>/dev/null
elif [ "$CMD" = linux ]; then
    set -x
    gcc -DLINUX -o /tmp/$APP_NAME $CFLAGS $SRCS \
        -I ../linux/local/include \
        -L ../linux/local/lib -lezapp_lib -lmp3lame -llodepng -lcJSON -lSDL3 -lSDL3_ttf -lSDL3_mixer -lm \
        -Wl,-rpath,../linux/local/lib
    { set +x; } 2>/dev/null
    exec -a $APP_NAME /tmp/$APP_NAME $PARENT_DIR/$APP_DIR
elif [ "$CMD" = picoc ]; then
    set -x
    ../src/picoc/picoc -n $APP_NAME $SRCS - $PARENT_DIR/$APP_DIR
    { set +x; } 2>/dev/null
fi

