#!/bin/bash

# default is to run the app using picoc
CMD=$1
if [ "$CMD" = "" ]; then
    CMD=run
fi

# set APP_NAME variable
APP_NAME=$(basename $(pwd))

# verify parent directory is 'apps' or 'svcs'
PARENT_DIR=$(basename $(dirname $PWD))
if [ "$PARENT_DIR" != apps -a "$PARENT_DIR" != svcs ]; then
    echo "ERROR: parent_dir must be apps or svcs"
    exit 1
fi

# print action
if [ "$CMD" == build ]; then
    echo "Performing linux build of $APP_NAME ..."
elif [ "$CMD" == run ]; then
    echo "Performing picoc run of $APP_NAME ..."
else
    echo "ERROR: expected: build, or run"
    echo "ERROR: default is run"
    exit 1
fi
echo

# build and run is performed from the 'files' dir
cd ../..

# get list of src files, relative to the 'files' dir
SRCS=$(echo $PARENT_DIR/$APP_NAME/*.c)

# debug prints, and
# enable bash verbose mode
#echo "PARENT_DIR  = $PARENT_DIR"
#echo "APP_NAME    = $APP_NAME"
#echo "SRCS        = $SRCS"
#set -x

# ensure the key libraries are built;
# note that this does not build all libraries,
# libraries which would need to be manually built (if changed) are:
# cJSON lodepng mp3lame SDL SDL_mixer SDL_ttf
make -C ../linux ezapp_lib picoc
if [ $? -ne 0 ]; then
    echo ABORT
    exit 1
fi

# always do test build using linux gcc
CFLAGS="-Wall -Werror -Wno-unused-result -Wno-format-truncation -Wno-unused-but-set-variable -fcommon -g -I. "
gcc -DLINUX -o /tmp/$APP_NAME $CFLAGS $SRCS \
    -I ../linux/local/include \
    -L ../linux/local/lib -lezapp_lib -lmp3lame -llodepng -lcJSON -lkissfft-float -lSDL3 -lSDL3_ttf -lSDL3_mixer -lm
if [ $? -ne 0 ]; then
    echo ABORT
    exit 1
fi

# if run requested then run program using picoc
if [ "$CMD" = run ]; then
    LIB_PATH=$(pwd)/../linux/local/lib
    gcc -o /tmp/picoc -D UNIX_HOST -O2 -g -Wall ../src/picoc/picoc.c \
        -L $LIB_PATH -lpicoc -lezapp_lib -lmp3lame -lcJSON -llodepng -lkissfft-float -lSDL3 -lSDL3_mixer -lSDL3_ttf -lm \
        -Wl,-rpath,$LIB_PATH
    cp ../bin/eztest_script.c /tmp
    sed -i -e "s=PROGNAME=$APP_NAME=" -e "s=DATA_DIR=$PARENT_DIR/$APP_NAME=" /tmp/eztest_script.c
    # the { } syntax preserves the exception message generated by the shell when the app crashes
    { /tmp/picoc -S $SRCS /tmp/eztest_script.c; } |& ezlogfilter
    if [ $? -ne 0 ]; then
        echo ABORT
        exit 1
    fi
fi

