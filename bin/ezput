#!/bin/bash

# Usage:
# - this must be invoked from an app or svc directory
# - the git tracked files in this directory are transferred to the Android device
# - if additional files need to be sent the additinal files are specified on the cmdline
# - examples, (note - the current dir must be an app or svc director):
#   - when making updates to an existing app or svc
#       ezput
#   - when making updates to an existing app and apps/lib files have also been updated
#       ezput apps/lib/*.[ch]
#   - when adding or updating a new app, that is not yet tracked by git
#       ezput apps/MyNewApp/* apps/layout

# verify parent directory is 'apps' or 'svcs'
parent_dir=$(basename $(dirname $PWD))
if [ "$parent_dir" != apps -a "$parent_dir" != svcs ]; then
  echo "ERROR: parent_dir must be apps or svcs"
  exit 1
fi

# determine the code directory containing the app or svc code
this_dir="$(basename $PWD)"
if [ "$parent_dir" = apps ]; then
  code_dir="apps/$this_dir"
else
  code_dir="svcs/$this_dir"
fi

# if more_files are specified in the caller args then 
# - check that the file does not begin with '..' or '/'
# - add the additional files to more_files variable
# endif
for i in $*; do
  if [[ "$i" == ".."* || "$i" == "/"* ]]; then
    echo "ERROR: $i invalid filename"
    exit 1
  fi
  more_files="$more_files $i"
done

# copy to Android:
# - git tracked files that are in the app/svc dir
# - more files which the caller has requested on the cmdline
cd ../..
files="$(git ls-files $code_dir) $more_files"
if [ "$files" = " " ]; then
  echo "ERROR: no files"
  exit 1
fi
tar -cf /tmp/ezput.tar  $files
if [ $? -ne 0 ]; then
  exit 1
fi
echo "Creating files on Android device ..."
ezsh put /tmp/ezput.tar 
ezsh tar -xvf ezput.tar
ezsh rm -f ezput.tar
rm -f /tmp/ezput.tar

exit 0
