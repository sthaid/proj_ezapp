#!/bin/bash

# Usage:
# - this must be invoked from an app or svc directory
# - with no args, the git tracked files in this directory are transferred to the Android device
# - with args, the files specified in the args are transferred to the Android device
#
# - examples:
#   - ezput dev password                    # sends git tracked files from this dir to android dev
#   - ezput dev password apps/layout        # sends just the apps/layout file to android dev
#   - ezput dev password apps/lib/lib.[ch]  # sends apps/lib/lib.[ch] to android dev

# verify current dir is in a git repo
top=$(git rev-parse --show-toplevel)
if [ $? -ne 0 ]; then
  echo "ERROR: not in git repo"
  exit 1
fi

# get device and password from env
dev=$EZAPP_DEVICE
password=$EZAPP_PASSWD

# set dev and password if the -d or -p options are supplied
while true; do
  if [ "$1" = "-d" ]; then
    dev=$2
    shift 2
  elif [ "$1" = "-p" ]; then
    password=$2
    shift 2
  else
    break
  fi
done

# verify dev and password args are provided
if [ "$dev" = "" -o "$password" = "" ]; then
  echo "ERROR: device and password are required"
  exit 1
fi

# verify parent directory is 'apps' or 'svcs'
parent_dir=$(basename $(dirname $PWD))
if [ "$parent_dir" != apps -a "$parent_dir" != svcs ]; then
  echo "ERROR: parent_dir must be apps or svcs"
  exit 1
fi

# determine the code directory containing the app or svc code
this_dir="$(basename $PWD)"
if [ "$parent_dir" = apps ]; then
  code_dir="apps/$this_dir"
else
  code_dir="svcs/$this_dir"
fi

# if files are specified in the caller args then 
# - check that the file does not begin with '..' or '/'
# endif
for i in $*; do
  if [[ "$i" == ".."* || "$i" == "/"* ]]; then
    echo "ERROR: $i invalid filename"
    exit 1
  fi
  specified_files="$specified_files $i"
done

# copy files to Android dev
cd ../..
if [ "$specified_files" != "" ]; then
  files="$specified_files"
else
  files="$(git ls-files $code_dir)"
  if [ "$files" = "" ]; then
    echo "ERROR: no files"
    exit 1
  fi
fi

tar -cf /tmp/ezput.tar  $files
if [ $? -ne 0 ]; then
  rm -f /tmp/ezput.tar
  exit 1
fi

echo "Creating files on Android device ..."
ezsh -d $dev -p $password -q "put /tmp/ezput.tar"
if [ $? -ne 0 ]; then 
  rm -f /tmp/ezput.tar
  exit 1
fi
ezsh -d $dev -p $password -q "tar -xvf ezput.tar"
if [ $? -ne 0 ]; then 
  rm -f /tmp/ezput.tar
  exit 1
fi
ezsh -d $dev -p $password -q "rm -f ezput.tar"
if [ $? -ne 0 ]; then 
  rm -f /tmp/ezput.tar
  exit 1
fi

rm -f /tmp/ezput.tar
exit 0
