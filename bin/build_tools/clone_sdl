#!/bin/bash

# cd to top of repo/src
top=$(git rev-parse --show-toplevel)
if [ $? -ne 0 ]; then
    echo "ERROR failed to get top repo directory"
    exit 1
fi
cd $top/src

# remove existing clones
rm -rf SDL SDL_ttf SDL_mixer

# clone repos
git clone https://github.com/libsdl-org/SDL
git clone https://github.com/libsdl-org/SDL_ttf
git clone https://github.com/libsdl-org/SDL_mixer

# checkout branches
cd $top/src/SDL;       git checkout -q release-3.4.0
cd $top/src/SDL_ttf;   git checkout -q 0165849a0061d91c51d4a3fa8bcda5b5fcf53cc9
cd $top/src/SDL_mixer; git checkout -q 092fafa4d820c45e3f05b59b7be75807ef3eefe8

# download external repos
cd $top/src/SDL_ttf/external;   ./download.sh
cd $top/src/SDL_mixer/external; ./download.sh

echo 
echo DONE
