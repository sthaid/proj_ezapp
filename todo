elif [ "$CMD" == run_on_linux ]; then
    echo "Performing linux run of $APP_NAME ..."
elif [ "$CMD" = run_on_linux ]; then
    CFLAGS="-Wall -Werror -Wno-unused-result -Wno-format-truncation -fcommon -g -I. "
    LIB_PATH=$(pwd)/../linux/local/lib
    gcc -DLINUX -o /tmp/$APP_NAME $CFLAGS $SRCS \
        -I ../linux/local/include \
        -L ../linux/local/lib -lezapp_lib -lmp3lame -llodepng -lcJSON -lkissfft-float -lSDL3 -lSDL3_ttf -lSDL3_mixer -lm \
        -Wl,-rpath,$LIB_PATH
    if [ $? -ne 0 ]; then
        echo ABORT
        exit 1
    fi
    # the { } syntax preserves the exception message generated by the shell when the app crashes
    { /tmp/$APP_NAME $PARENT_DIR/$APP_NAME; } |& ezlogfilter
fi

